# Copy to secrets.env and fill CHANGE_ME values.
# Non-secret prod settings → deployment/k8s/overlays/k3s/api-configmap.yaml
#
#   cp deployment/k3s/secrets.env.example deployment/k3s/secrets.env
#   nano deployment/k3s/secrets.env
#   ./deployment/k3s/create-secrets.sh
#   ./deployment/k3s/create-ghcr-pull-secret.sh   # для pull из GHCR
#
# secrets.env is gitignored — never commit real passwords/tokens.

ROADMAP_AUTH_JWT_SECRET=CHANGE_ME
ROADMAP_DB_PASSWORD=CHANGE_ME
ROADMAP_AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME

# Telegram (required for prod bot / feedback). Can be empty for first bring-up.
ROADMAP_TELEGRAM_BOT_TOKEN=
ROADMAP_TELEGRAM_WEBHOOK_SECRET=

# GHCR pull (private packages). Classic PAT: read:packages.
# https://github.com/settings/tokens
GHCR_USERNAME=CHANGE_ME
GHCR_TOKEN=CHANGE_ME
# GHCR_EMAIL=noreply@users.noreply.github.com
