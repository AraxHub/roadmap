# Env: dev = TG polling, prod = setWebhook
ROADMAP_ENV=dev

# Сервер (ROADMAP_SERVER_*)
ROADMAP_SERVER_HOST=0.0.0.0
ROADMAP_SERVER_PORT=8080

# PostgreSQL (ROADMAP_DB_*)
ROADMAP_DB_HOST=localhost
ROADMAP_DB_PORT=5434
ROADMAP_DB_USER=postgres
ROADMAP_DB_PASSWORD=postgres
ROADMAP_DB_NAME=roadmap
ROADMAP_DB_SSLMODE=disable

# Auth (ROADMAP_AUTH_*)
ROADMAP_AUTH_JWT_SECRET=dev-secret-change-me
ROADMAP_AUTH_ACCESS_TTL=15m
ROADMAP_AUTH_REFRESH_TTL=72h
ROADMAP_AUTH_REFRESH_COOKIE_NAME=refresh_token
ROADMAP_AUTH_REFRESH_COOKIE_SECURE=false
ROADMAP_AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
ROADMAP_AUTH_BOOTSTRAP_LOGIN=admin
ROADMAP_AUTH_BOOTSTRAP_PASSWORD=admin

# Sprint
ROADMAP_SPRINT_DURATION=168h

# Telegram
ROADMAP_TELEGRAM_BOT_TOKEN=
ROADMAP_TELEGRAM_BOT_USERNAME=
ROADMAP_TELEGRAM_WEBHOOK_SECRET=
# prod only: полный HTTPS URL, напр. https://api.example.com/api/v1/telegram/webhook
ROADMAP_TELEGRAM_WEBHOOK_URL=
ROADMAP_TELEGRAM_POLLING_TIMEOUT=30
ROADMAP_TELEGRAM_FEEDBACK_TZ=Europe/Moscow
